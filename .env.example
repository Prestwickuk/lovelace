# LOVELACE Booking System — Production Environment Template
# For production, generate strong random secrets:
#   openssl rand -hex 32
TIRBACH_ENV=production
TIRBACH_LISTEN_ADDR=0.0.0.0:8080
TIRBACH_COOKIE_SECURE=true
TIRBACH_TRUST_PROXY=true
# Comma-separated CIDRs of trusted reverse proxies allowed to supply X-Forwarded-For:
TIRBACH_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
LOVELACE_TRUST_PROXY=true
LOVELACE_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
TIRBACH_BIND_ADDR=127.0.0.1
TIRBACH_PORT=8080

POSTGRES_DB=tir_bach
# Bootstrap admin identity used ONLY by postgres/db-bootstrap (never passed to app container).
# When upgrading an existing Phase 1.5 volume initialized with POSTGRES_USER=tir_bach, keep tir_bach here.
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD

# Non-superuser migration/DDL owner role (used only by migrate service / tirbach-migrate):
LOVELACE_MIGRATOR_USER=lovelace_migrator
LOVELACE_MIGRATOR_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_PASSWORD

# Non-superuser, strictly DML-only application runtime role (used by app container):
LOVELACE_APP_USER=lovelace_app
LOVELACE_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Direct CLI invocation URL (uses DML-only runtime identity in production):
DATABASE_URL=postgres://lovelace_app:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:5432/tir_bach?sslmode=require
MIGRATION_DATABASE_URL=postgres://lovelace_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@127.0.0.1:5432/tir_bach?sslmode=require

# 32-byte key (64 hex chars or base64) used for AES-256-GCM encryption of channel credentials
TIRBACH_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_FROM_OPENSSL_RAND_HEX_32

# Auto-seeding is prohibited in production and will fail closed if enabled.
TIRBACH_AUTO_SEED=false

# Phase 2 / 2.1 — Public Booking Frontend & Fail-Closed Public BFF Isolation
# Canonical public booking origin for the initial deployment (`https://book.tirbach.wales`).
# Must be HTTPS in production (non-loopback) and matches approved property domain(s):
TIRBACH_PUBLIC_ORIGIN=https://book.tirbach.wales
LOVELACE_PROPERTY_SLUG=tir-bach
# REQUIRED in production: shared secret sent server-to-server by Next.js public-web -> Go backend.
# Direct unauthenticated external callers to Go /api/public/v1/* are rejected.
TIRBACH_PUBLIC_API_SECRET=REPLACE_WITH_STRONG_PUBLIC_API_SECRET_FROM_OPENSSL_RAND_HEX_32
LOVELACE_STRIPE_SANDBOX=false
PUBLIC_WEB_BIND_ADDR=127.0.0.1
PUBLIC_WEB_PORT=3000

# Live Stripe keys (sk_test_/rk_test_ and sandbox mode are REJECTED in TIRBACH_ENV=production).
# Supply `sk_live_...` or appropriately scoped `rk_live_...` + matching `whsec_...` when any public property has stripe_enabled=true.
# If online card payments are intentionally disabled at property policy level (stripe_enabled=false), leave empty.
TIRBACH_STRIPE_SECRET_KEY=
TIRBACH_STRIPE_WEBHOOK_SECRET=
TIRBACH_STRIPE_SANDBOX=false

# Outbox confirmation email delivery.
# Properties accepting live public bookings ALWAYS require a genuine SMTP provider in production.
# Set TIRBACH_REQUIRE_EMAIL=false ONLY for administration-only or stripe_enabled=false deployments without SMTP.
# Without SMTP_ADDR configured (when permitted), outbox items remain PENDING (never silently marked SENT) and /readyz reports unconfigured.
TIRBACH_REQUIRE_EMAIL=true
TIRBACH_EMAIL_FROM=bookings@tirbach.wales
TIRBACH_SMTP_ADDR=
TIRBACH_SMTP_USERNAME=
TIRBACH_SMTP_PASSWORD=

# Non-public maintenance attachment storage (stored outside any web root; max upload size in bytes).
TIRBACH_ATTACHMENT_DIR=/var/lib/lovelace/attachments
TIRBACH_MAX_ATTACHMENT_BYTES=10485760
