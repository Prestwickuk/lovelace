# LOVELACE Booking System — Production Environment Template
# For production, generate strong random secrets:
#   openssl rand -hex 32
LOVELACE_ENV=production
LOVELACE_LISTEN_ADDR=0.0.0.0:8080
LOVELACE_COOKIE_SECURE=true
LOVELACE_TRUST_PROXY=true
# Comma-separated CIDRs of trusted reverse proxies allowed to supply X-Forwarded-For:
LOVELACE_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
LOVELACE_BIND_ADDR=127.0.0.1
LOVELACE_PORT=8080

POSTGRES_DB=lovelace
# Bootstrap admin identity used ONLY by postgres/db-bootstrap (never passed to app container).
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD

# Non-superuser migration/DDL owner role (used only by migrate service / lovelace-migrate):
LOVELACE_MIGRATOR_USER=lovelace_migrator
LOVELACE_MIGRATOR_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_PASSWORD

# Non-superuser, strictly DML-only application runtime role (used by app container):
LOVELACE_APP_USER=lovelace_app
LOVELACE_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Direct CLI invocation URL (uses DML-only runtime identity in production):
DATABASE_URL=postgres://lovelace_app:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:5432/lovelace?sslmode=require
MIGRATION_DATABASE_URL=postgres://lovelace_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@127.0.0.1:5432/lovelace?sslmode=require

# 32-byte key (64 hex chars or base64) used for AES-256-GCM encryption of channel/backup credentials and HMAC subkeys:
LOVELACE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_FROM_OPENSSL_RAND_HEX_32

# Auto-seeding is prohibited in production and will fail closed if enabled.
LOVELACE_AUTO_SEED=false

# Optional first-boot Owner-Admin provisioning (runs ONLY when admin_users has 0 rows; forces password rotation on first login):
LOVELACE_BOOTSTRAP_ADMIN_EMAIL=
LOVELACE_BOOTSTRAP_ADMIN_NAME=Owner Administrator
LOVELACE_BOOTSTRAP_ADMIN_PASSWORD=

# Public Booking Frontend & Fail-Closed Public BFF Isolation
# Canonical public booking origin for your deployment (e.g. https://book.example.com; comma-separated if multiple domains).
# Must be HTTPS in production (non-loopback) and matches approved property domain(s):
LOVELACE_PUBLIC_ORIGIN=https://book.example.com
LOVELACE_PROPERTY_SLUG=demo-property
# REQUIRED in production: shared secret sent server-to-server by Next.js public-web -> Go backend.
# Direct unauthenticated external callers to Go /api/public/v1/* are rejected.
LOVELACE_PUBLIC_API_SECRET=REPLACE_WITH_STRONG_PUBLIC_API_SECRET_FROM_OPENSSL_RAND_HEX_32
# Self-Service Guest Portal deployment gate (MUST remain false in production until pilot sign-off):
LOVELACE_GUEST_PORTAL_ENABLED=false
PUBLIC_WEB_BIND_ADDR=127.0.0.1
PUBLIC_WEB_PORT=3000

# Live Stripe keys (sk_test_/rk_test_ and sandbox mode are REJECTED in LOVELACE_ENV=production).
# Supply `sk_live_...` or appropriately scoped `rk_live_...` + matching `whsec_...` (pointing to POST /api/public/v1/webhooks/stripe)
# when any public property has stripe_enabled=true. If online card payments are disabled (stripe_enabled=false), leave empty.
LOVELACE_STRIPE_SECRET_KEY=
LOVELACE_STRIPE_WEBHOOK_SECRET=
LOVELACE_STRIPE_SANDBOX=false

# Outbox confirmation email delivery & signed delivery/bounce webhooks (POST /api/v1/webhooks/email-events).
# Properties accepting live public bookings ALWAYS require a genuine STARTTLS (:587) SMTP provider in production.
# Set LOVELACE_REQUIRE_EMAIL=false ONLY for administration-only or stripe_enabled=false deployments without SMTP.
LOVELACE_REQUIRE_EMAIL=true
LOVELACE_EMAIL_FROM=bookings@example.com
LOVELACE_EMAIL_WEBHOOK_SECRET=
LOVELACE_SMTP_ADDR=
LOVELACE_SMTP_USERNAME=
LOVELACE_SMTP_PASSWORD=

# Non-public maintenance & branding attachment storage (stored outside any web root; max upload size 1024..52428800 bytes).
LOVELACE_ATTACHMENT_DIR=/var/lib/lovelace/attachments
LOVELACE_MAX_ATTACHMENT_BYTES=10485760
