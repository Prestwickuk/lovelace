LOVELACE_API_BASE_URL=http://127.0.0.1:8080
LOVELACE_PROPERTY_SLUG=tir-bach
# Required in production so direct unauthenticated external access to Go public API is blocked:
LOVELACE_PUBLIC_API_SECRET=
# Reverse proxy trust settings for Next.js BFF per-client rate limiting:
LOVELACE_TRUST_PROXY=false
LOVELACE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Sandbox checkout routes are disabled in production unless explicitly overridden for isolated QA:
LOVELACE_STRIPE_SANDBOX=true
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
